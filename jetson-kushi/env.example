# Copy to .env and fill in real values for this board, then `source .env` before
# running anything under robot/. Everything below is a PLACEHOLDER - none of it is
# safe to trust until verified on the actual Jetson.

# Serial port for the SO-101 follower arm. COM7 was the Windows rig (docs/SETUP_NOTES.md).
# On Linux this is a /dev/tty* path, and it is NOT guaranteed stable across reboots or
# replugs - re-check it, don't assume it matches last time. Find it with:
#   python -c "from serial.tools import list_ports; [print(p.device, p.serial_number) for p in list_ports.comports()]"
# and match by board serial (5B79080156 = follower, per docs/SETUP_NOTES.md), not by path.
ROBOT_PORT=/dev/ttyACM0

# Camera index is NOT read from an env var yet - it's CAMERA_INDEX in
# robot/perception/config.py. V4L2 enumerates cameras differently than DirectShow did
# on Windows, so don't assume index 1 carries over. Check with: v4l2-ctl --list-devices
# and edit CAMERA_INDEX directly once confirmed.
