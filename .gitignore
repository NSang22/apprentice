# Per AGENTS.md: never commit large videos, journals, or secrets.
videos/
data/sessions/
!data/sessions/sample*.jsonl
data/trials.csv

# Robot run artifacts: debug frames, run logs, calibration snapshots.
# About 70 MB locally, regenerated by every run.
robot/outputs/

# Lessons are generated output. Commit one checked-in sample if the team wants a fixture.
lessons/*.json
!lessons/sample*.json

# per-machine camera calibration, recalibrated at the demo table
perception/calib/*.json
perception/calib/*.png

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# UI
node_modules/
dist/
build/
.next/

# Secrets. API keys live here, never in the repo.
.env
.env.*
!.env.example

# Media too big for git
*.mp4
*.mov
*.MOV

# OS and editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local scratch: camera snapshots, patches, per-machine settings
logs/
one-command.patch
snap.py
scripts/jetson.env
